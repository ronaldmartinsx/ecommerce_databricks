{
  "datasets": [
    {
      "name": "ds_precos",
      "displayName": "Preços vs. concorrência (um produto por linha)",
      "queryLines": [
        "-- Um produto por linha. Preço suspeito (algum concorrente abaixo de 60% do nosso preço) é erro de\n",
        "-- coleta ou promoção: fica visível, mas separado do que é confirmado.\n",
        "-- diferenca_pct_* está em pontos percentuais: dividido por 100 para o formato de %.\n",
        "SELECT\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  marca,\n",
        "  classificacao_preco,\n",
        "  CASE classificacao_preco\n",
        "    WHEN 'MAIS_CARO_QUE_TODOS' THEN 'Mais caro que todos'\n",
        "    WHEN 'ACIMA_DA_MEDIA' THEN 'Acima da média'\n",
        "    WHEN 'NA_MEDIA' THEN 'Na média'\n",
        "    WHEN 'ABAIXO_DA_MEDIA' THEN 'Abaixo da média'\n",
        "    WHEN 'MAIS_BARATO_QUE_TODOS' THEN 'Mais barato que todos'\n",
        "    ELSE classificacao_preco\n",
        "  END AS classificacao,\n",
        "  possui_preco_suspeito,\n",
        "  CASE WHEN possui_preco_suspeito THEN 'A confirmar (preço suspeito)' ELSE 'Confirmado' END AS situacao_preco,\n",
        "  CASE WHEN possui_preco_suspeito THEN 'Sim' ELSE 'Não' END AS preco_a_confirmar,\n",
        "  nosso_preco,\n",
        "  preco_medio_concorrentes,\n",
        "  preco_minimo_concorrentes,\n",
        "  total_concorrentes,\n",
        "  diferenca_pct_vs_media / 100 AS dif_vs_media,\n",
        "  diferenca_pct_vs_minimo / 100 AS dif_vs_minimo,\n",
        "  receita,\n",
        "  itens_vendidos,\n",
        "  CASE WHEN classificacao_preco = 'MAIS_CARO_QUE_TODOS' AND NOT possui_preco_suspeito THEN id_produto END AS id_mais_caro_confirmado,\n",
        "  CASE WHEN classificacao_preco = 'MAIS_CARO_QUE_TODOS' AND NOT possui_preco_suspeito THEN receita END AS receita_mais_caro_confirmado,\n",
        "  CASE WHEN possui_preco_suspeito THEN id_produto END AS id_suspeito\n",
        "FROM precos_competitividade\n",
        "ORDER BY receita DESC, nome_produto\n"
      ],
      "columns": [
        {
          "displayName": "produtos",
          "description": "Produtos monitorados (por id_produto)",
          "expression": "COUNT(DISTINCT `id_produto`)"
        },
        {
          "displayName": "mais_caros_confirmados",
          "description": "MAIS_CARO_QUE_TODOS sem preço suspeito",
          "expression": "COUNT(DISTINCT `id_mais_caro_confirmado`)"
        },
        {
          "displayName": "receita_mais_caros_confirmados",
          "description": "Receita dos produtos mais caros que todos, confirmados",
          "expression": "SUM(`receita_mais_caro_confirmado`)"
        },
        {
          "displayName": "produtos_suspeitos",
          "description": "Produtos com preço suspeito a conferir",
          "expression": "COUNT(DISTINCT `id_suspeito`)"
        },
        {
          "displayName": "dif_media_mercado",
          "description": "Média da diferença do nosso preço vs. média dos concorrentes (fração)",
          "expression": "AVG(`dif_vs_media`)"
        }
      ]
    }
  ],
