{
  "datasets": [
    {
      "name": "ds_clientes",
      "displayName": "Clientes (um por linha)",
      "queryLines": [
        "-- Um cliente por linha (inclusive quem nunca comprou). ultima_compra está em UTC.\n",
        "SELECT\n",
        "  ranking_receita,\n",
        "  id_cliente,\n",
        "  nome_cliente,\n",
        "  estado,\n",
        "  nome_estado,\n",
        "  regiao,\n",
        "  segmento_cliente,\n",
        "  total_compras,\n",
        "  receita,\n",
        "  ultima_compra\n",
        "FROM clientes_segmentacao\n",
        "ORDER BY ranking_receita\n"
      ],
      "columns": [
        {
          "displayName": "clientes",
          "description": "Clientes distintos",
          "expression": "COUNT(DISTINCT `id_cliente`)"
        },
        {
          "displayName": "clientes_vip",
          "description": "Clientes do segmento VIP",
          "expression": "COUNT(DISTINCT CASE WHEN `segmento_cliente` = 'VIP' THEN `id_cliente` END)"
        },
        {
          "displayName": "receita_total",
          "description": "Receita em R$",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "pct_receita_vip",
          "description": "Receita dos VIP ÷ receita total",
          "expression": "SUM(CASE WHEN `segmento_cliente` = 'VIP' THEN `receita` ELSE 0 END) / SUM(`receita`)"
        },
        {
          "displayName": "ticket_medio",
          "description": "Receita ÷ número de compras",
          "expression": "SUM(`receita`) / SUM(`total_compras`)"
        }
      ]
    }
  ],
